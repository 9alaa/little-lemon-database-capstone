digraph ER {graph [rankdir=LR,bgcolor="white",pad=.3]; node [shape=record,style="rounded,filled",fillcolor="#EDF4F8",color="#476A7D",fontname="Helvetica",fontsize=11]; edge [color="#627E8D",arrowsize=.7]; Customers [label="{Customers|PK CustomerID|CustomerName|Email|Phone}"];Bookings [label="{Bookings|PK BookingID|FK CustomerID|BookingDate|BookingTime|TableNumber|GuestCount|BookingStatus}"];Orders [label="{Orders|PK OrderID|FK CustomerID|FK BookingID|OrderDate|OrderStatus}"];MenuItems [label="{MenuItems|PK MenuItemID|ItemName|Category|Price}"];OrderItems [label="{OrderItems|PK OrderItemID|FK OrderID|FK MenuItemID|Quantity|UnitPrice}"];Customers->Bookings [label="1:N"];Customers->Orders [label="1:N"];Bookings->Orders [label="1:N (optional)"];Orders->OrderItems [label="1:N"];MenuItems->OrderItems [label="1:N"];}
